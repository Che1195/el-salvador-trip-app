# Names only. Never put values in this file, and never commit a real .env.
# Set real values in the hosting provider's environment settings, separately
# for Production and Preview.

# Signing key for web sessions. At least 32 characters of random data.
# Rotating it signs everyone out.
SESSION_SECRET=

# One-way scrypt hash of the shared trip password. Produce it with:
#   bun run hash-password
# Changing it signs everyone out.
TRIP_PASSWORD_HASH=

# Extra origins the web app is served from, comma separated (custom domains).
# Vercel's own deployment URLs are trusted automatically.
APP_ORIGINS=

# Optional. Id of the single trip this deployment serves. Defaults to trip_1.
TRIP_ID=

# Preview only, optional. "1" serves the fictitious sample trip from memory.
# Ignored in production.
TRIP_FIXTURE_PREVIEW=

# Local development only, optional. A throwaway token (32+ characters) that
# turns on the local MCP fixture agent. Ignored in every deployed environment.
MCP_DEV_FIXTURE_TOKEN=
